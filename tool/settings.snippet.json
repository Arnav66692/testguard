{
  "comment": "Copy tool/ into .claude/testguard/ in the target project. Merge this hooks object into .claude/settings.json. CLAUDE_PROJECT_DIR is the project root.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/testguard/hooks/log_command.py\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/testguard/hooks/log_command.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/testguard/hooks/detect_gaming.py\""
          }
        ]
      }
    ]
  }
}
